APP_ENV=local

# Used in config/common/params.php. If left blank defaults to 'ddd_template'
DB_NAME=

# If left blank defaults to 'root'
DB_USERNAME=

# If left blank defaults to null
DB_PASSWORD=

# If left blank defaults to 'localhost'
DB_HOST_IP_ADDRESS=

YII_ENV=dev
YII_DEBUG=true

# Set true, sync the schema (see config/common/params.php's yiisoft/yii-cycle
# schema-providers comment), then set back to false.
BUILD_DATABASE=

BASE_URL=

# Signs/encrypts cookies including the "remember me" login flow — required.
COOKIE_SECRET_KEY=

SESSION_COOKIE_SECURE=false

SENDER_EMAIL=info@yourhost.com
ADMIN_EMAIL=info@yourhost.com
SYMFONY_MAILER_HOST=smtp.gmail.com
SYMFONY_MAILER_PORT=465
SYMFONY_MAILER_USERNAME=
SYMFONY_MAILER_PASSWORD=

# OAuth social-login providers (all optional — a provider without
# clientId/clientSecret set just won't work, everything else keeps running)
FACEBOOK_API_CLIENT_ID=
FACEBOOK_API_CLIENT_SECRET=
FACEBOOK_API_CLIENT_RETURN_URL=

GITHUB_API_CLIENT_ID=
GITHUB_API_CLIENT_SECRET=
GITHUB_API_CLIENT_RETURN_URL=

GOOGLE_API_CLIENT_ID=
GOOGLE_API_CLIENT_SECRET=
GOOGLE_API_CLIENT_RETURN_URL=

LINKEDIN_API_CLIENT_ID=
LINKEDIN_API_CLIENT_SECRET=
LINKEDIN_API_CLIENT_RETURN_URL=

MICROSOFTONLINE_API_CLIENT_ID=
MICROSOFTONLINE_API_CLIENT_SECRET=
MICROSOFTONLINE_API_CLIENT_RETURN_URL=
MICROSOFTONLINE_API_CLIENT_TENANT=common

VKONTAKTE_API_CLIENT_ID=
VKONTAKTE_API_CLIENT_SECRET=
VKONTAKTE_API_CLIENT_RETURN_URL=

X_API_CLIENT_ID=
X_API_CLIENT_SECRET=
X_API_CLIENT_RETURN_URL=

YANDEX_API_CLIENT_ID=
YANDEX_API_CLIENT_SECRET=
YANDEX_API_CLIENT_RETURN_URL=
