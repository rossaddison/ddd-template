<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    strictBinaryOperands="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="config" />
        <directory name="resources/views" />
        <directory name="src" />
        <file name="public/index.php"/>
        <file name="yii"/>
        <file name="autoload.php"/>
        <ignoreFiles>
            <directory name="vendor" />
            <!-- Depends on src/Auth/Form/SignupForm.php, not yet ported (Auth/OAuth/2FA
                 port is deliberately deferred to its own session) — see docs/PROGRESS.md -->
            <file name="src/User/Console/CreateCommand.php" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </PossiblyUnusedProperty>
        <PossiblyUnusedReturnValue>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </PossiblyUnusedReturnValue>
        <!-- Same rationale as the PossiblyUnused* suppressions above: this
             template repo's Auth/OAuth/2FA port is deliberately deferred (see
             docs/PROGRESS.md), so several classes genuinely have no callers
             yet within this repo's own analysis scope. -->
        <UnusedParam>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </UnusedParam>
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="src" />
            </errorLevel>
        </UnusedClass>
        <!-- Cycle/ORM requires Entity classes not to be final so proxies can
             be created using the ProxyFactory. -->
        <ClassMustBeFinal errorLevel="suppress">
             <errorLevel type="suppress">
                <directory name="src/Infrastructure/Persistence" />
            </errorLevel>
        </ClassMustBeFinal>
    </issueHandlers>
</psalm>
