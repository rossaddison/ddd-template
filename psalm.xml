<?xml version="1.0"?>
<psalm
    errorLevel="1"
    findUnusedBaselineEntry="true"
    findUnusedCode="true"
    strictBinaryOperands="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="https://getpsalm.org/schema/config vendor/vimeo/psalm/config.xsd"
>
    <projectFiles>
        <directory name="config" />
        <directory name="resources/views" />
        <directory name="src" />
        <file name="public/index.php"/>
        <file name="yii"/>
        <file name="autoload.php"/>
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
    <issueHandlers>
        <PossiblyUnusedMethod>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </PossiblyUnusedMethod>
        <PossiblyUnusedProperty>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </PossiblyUnusedProperty>
        <PossiblyUnusedReturnValue>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </PossiblyUnusedReturnValue>
        <!-- Same rationale as the PossiblyUnused* suppressions above: this is
             a template repo — several route-bound method params (e.g. the
             #[RouteArgument('_language')] on every OAuth callback) and
             classes are consumed by the router/DI container, not by other
             PHP code Psalm can trace call graphs through. -->
        <UnusedParam>
            <errorLevel type="suppress">
                <directory name="src" />
                <directory name="resources" />
            </errorLevel>
        </UnusedParam>
        <UnusedClass>
            <errorLevel type="suppress">
                <directory name="src" />
            </errorLevel>
        </UnusedClass>
        <!-- Yiisoft\FormModel\FormModel reads private properties like
             LoginForm::$rememberMe via reflection (getPropertyValue()), not
             a direct $this-> reference Psalm's static analysis can trace. -->
        <UnusedProperty>
            <errorLevel type="suppress">
                <directory name="src/Auth/Form" />
            </errorLevel>
        </UnusedProperty>
        <!-- Cycle/ORM requires Entity classes not to be final so proxies can
             be created using the ProxyFactory. -->
        <ClassMustBeFinal errorLevel="suppress">
             <errorLevel type="suppress">
                <directory name="src/Infrastructure/Persistence" />
            </errorLevel>
        </ClassMustBeFinal>
    </issueHandlers>
</psalm>
